---
/**
 * A modern aside inside period-voice prose. Breaks out of the italic into
 * roman sans, so the reader always knows which register is speaking.
 */
---

<span class="modern"><slot /></span>

<style>
  .modern {
    font-style: normal;
    font-size: 15px;
    font-family: var(--sans);
  }
</style>
