---
/**
 * Two instruments at the same scale, and the simpler one wins. Hooke's compound
 * tube multiplies the magnifications of two lenses and multiplies their
 * aberrations with them — workable to about 30 diameters. Leeuwenhoek's is one
 * almost spherical bead in a brass plate: a very short focal length gives the
 * magnification directly, and one surface contributes one lens's worth of error.
 */
---

<svg viewBox="0 0 960 440" role="img" aria-label="Hooke's compound microscope beside Leeuwenhoek's single-bead instrument at the same scale, with their magnifications compared and the two centuries before anything followed medically">
  <!-- ══ Hooke, 1665 ════════════════════════════════════════════════════ -->
  <text class="dg-lbl dg-num" x="30" y="24">HOOKE'S COMPOUND MICROSCOPE, 1665</text>
  <text class="dg-lbl dg-soft" x="30" y="38">TWO LENSES IN SERIES · ABOUT 400 MM LONG</text>

  <path class="dg-s" d="M172 54 C182 46, 194 46, 204 54" />
  <text class="dg-lbl dg-soft" x="214" y="56">EYE</text>

  <path class="dg-panel" d="M156 64 H220 V240 H156 Z" />
  <path class="dg-s" d="M156 64 H220 V240 H156 Z" />
  <path class="dg-s" d="M148 56 H228 V64 H148 Z" />
  <path class="dg-s" d="M164 240 H212 V266 H164 Z" />

  <path class="dg-a" d="M188 74 C198 82, 198 94, 188 102 C178 94, 178 82, 188 74 Z" />
  <path class="dg-a" d="M188 236 C196 242, 196 252, 188 258 C180 252, 180 242, 188 236 Z" />
  <text class="dg-lbl dg-key" x="240" y="92">EYEPIECE</text>
  <text class="dg-lbl dg-key" x="240" y="254">OBJECTIVE</text>

  <g class="dg-h">
    <path d="M176 236 V102 M200 236 V102" />
  </g>
  <text class="dg-lbl dg-soft" x="240" y="150">THE MAGNIFICATIONS</text>
  <text class="dg-lbl dg-soft" x="240" y="164">MULTIPLY —</text>
  <text class="dg-lbl dg-num" x="240" y="186">AND SO DO THE</text>
  <text class="dg-lbl dg-num" x="240" y="200">ABERRATIONS OF BOTH</text>

  <path class="dg-s" d="M128 278 H248" />
  <circle cx="188" cy="272" r="3" class="dg-ink" />
  <text class="dg-lbl dg-soft" x="128" y="296">SPECIMEN ON THE STAGE</text>

  <!-- ══ Leeuwenhoek, 1670s ═════════════════════════════════════════════ -->
  <path class="dg-m" d="M470 14 V296" />
  <text class="dg-lbl dg-num" x="500" y="24">LEEUWENHOEK'S SINGLE BEAD, 1670s</text>
  <text class="dg-lbl dg-soft" x="500" y="38">ONE LENS · ABOUT 50 MM LONG, SAME SCALE</text>

  <path class="dg-s" d="M614 156 C624 148, 636 148, 646 156" />
  <text class="dg-lbl dg-soft" x="656" y="156">EYE, PRESSED CLOSE</text>

  <path class="dg-panel" d="M600 170 H636 V266 H600 Z" />
  <path class="dg-s" d="M600 170 H636 V266 H600 Z" />
  <path class="dg-page" d="M608 200 h20 v20 h-20 Z" />
  <path class="dg-s" d="M608 200 h20 v20 h-20 Z" />
  <circle cx="618" cy="210" r="8" class="dg-a" />
  <text class="dg-lbl dg-key" x="656" y="200">THE BEAD — ALMOST A SPHERE</text>
  <text class="dg-lbl dg-soft" x="656" y="214">A VERY SHORT FOCAL LENGTH</text>
  <text class="dg-lbl dg-soft" x="656" y="236">ONE SURFACE, SO ONE LENS'S</text>
  <text class="dg-lbl dg-soft" x="656" y="250">WORTH OF ERROR</text>

  <path class="dg-s" d="M588 210 H566" />
  <circle cx="564" cy="210" r="2.6" class="dg-ink" />
  <path class="dg-s" d="M588 210 V254" />
  <path class="dg-m" d="M582 254 h12 M582 268 h12" />
  <text class="dg-lbl dg-soft" x="500" y="288">SPECIMEN ON A PIN, SET BY SCREWS</text>

  <!-- ══ what each resolves ═════════════════════════════════════════════ -->
  <path class="dg-m" d="M30 312 H930" />
  <text class="dg-lbl" x="30" y="334">MAGNIFICATION, TO SCALE</text>

  <rect x="30" y="344" width="31" height="14" class="dg-ink" />
  <text class="dg-lbl dg-num" x="72" y="355">30× · HOOKE, AND MUSHY BEYOND IT</text>
  <rect x="30" y="368" width="279" height="14" class="dg-accent" />
  <text class="dg-lbl dg-key" x="320" y="379">270× · LEEUWENHOEK</text>

  <text class="dg-lbl dg-soft" x="30" y="406">HIS BEST INSTRUMENTS RESOLVE DETAIL NO COMPOUND</text>
  <text class="dg-lbl dg-soft" x="30" y="420">MICROSCOPE MATCHES FOR ANOTHER CENTURY AND A HALF.</text>

  <!-- ── and why nothing follows medically ────────────────────────────── -->
  <path class="dg-m" d="M470 322 V430" />
  <text class="dg-lbl" x="500" y="334">AND WHY NOTHING FOLLOWS MEDICALLY FOR 200 YEARS</text>

  <circle cx="548" cy="382" r="34" class="dg-h" />
  <g class="dg-m">
    <path d="M534 370 c6 -4 12 0 10 6 M558 376 c6 -4 12 2 8 8 M538 394 c6 -5 13 1 9 7
             M562 396 c5 -5 12 0 9 6 M546 360 c5 -4 11 0 9 5" />
  </g>
  <text class="dg-lbl dg-soft" x="548" y="430" text-anchor="middle">POND WATER</text>

  <circle cx="646" cy="382" r="34" class="dg-h" />
  <g class="dg-m">
    <path d="M632 370 c6 -4 12 0 10 6 M656 378 c6 -4 12 2 8 8 M636 394 c6 -5 13 1 9 7
             M660 394 c5 -5 12 0 9 6 M644 362 c5 -4 11 0 9 5" />
  </g>
  <text class="dg-lbl dg-soft" x="646" y="430" text-anchor="middle">A HEALTHY MOUTH</text>

  <text class="dg-lbl dg-num" x="712" y="366">SEEING AN ORGANISM IS NOT</text>
  <text class="dg-lbl dg-num" x="712" y="380">SHOWING IT CAUSES ANYTHING.</text>
  <text class="dg-lbl dg-soft" x="712" y="402">NOTHING IN EITHER IMAGE SAYS</text>
  <text class="dg-lbl dg-soft" x="712" y="416">WHICH ONES MATTER. THE ARGUMENT</text>
  <text class="dg-lbl dg-soft" x="712" y="430">NEEDS KOCH, IN 1876.</text>
</svg>
