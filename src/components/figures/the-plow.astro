---
/**
 * The ard in section: yoke, beam, share, stilt. The share is a wedge that parts
 * the soil and lets it fall back, so the furrow closes behind the plough and the
 * sod is never inverted. That is why an ard field is cross-ploughed at right
 * angles — the second pass does what one pass cannot.
 */
---

<svg viewBox="0 0 960 400" role="img" aria-label="An ard plough in section with yoke, beam, share and stilt, the furrow it cuts, and the cross-ploughing it requires">
  <defs>
    <marker id="pl-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-accent" />
    </marker>
  </defs>

  <text class="dg-lbl" x="30" y="24">THE ARD IN SECTION · TRAVELLING LEFT</text>

  <!-- ── ground line, with the furrow closing behind the share ────────── -->
  <path class="dg-s" d="M30 230 H246" />
  <path class="dg-m" d="M246 230 C258 244, 272 246, 288 242 C320 234, 356 230, 400 230" />
  <path class="dg-s" d="M400 230 H620" />
  <g class="dg-h">
    <path d="M44 246 l14 -14 M80 246 l14 -14 M116 246 l14 -14 M152 246 l14 -14 M188 246 l14 -14
             M224 246 l14 -14 M300 250 l14 -14 M336 248 l14 -14 M412 246 l14 -14 M448 246 l14 -14
             M484 246 l14 -14 M520 246 l14 -14 M556 246 l14 -14 M592 246 l14 -14" />
  </g>

  <!-- disturbed soil around the buried share -->
  <path class="dg-d" d="M236 236 C246 268, 276 278, 320 268 C356 260, 380 244, 392 232" />

  <!-- ── the stock and share ──────────────────────────────────────────── -->
  <path class="dg-s" d="M250 262 L430 208" />
  <path class="dg-s" d="M250 262 L326 240 L322 224 L246 248 Z" />
  <text class="dg-lbl dg-num" x="238" y="300">SHARE</text>
  <text class="dg-lbl dg-soft" x="238" y="314">A WEDGE, NOT A BLADE</text>
  <path class="dg-m" d="M272 254 L262 292" />

  <!-- ── the stilt ────────────────────────────────────────────────────── -->
  <path class="dg-s" d="M404 216 L470 106" />
  <path class="dg-s" d="M470 106 C478 94, 496 92, 506 100" />
  <text class="dg-lbl dg-num" x="484" y="70">STILT</text>
  <text class="dg-lbl dg-soft" x="484" y="84">THE ONLY CONTROL</text>

  <!-- ── the beam, forward to the yoke ────────────────────────────────── -->
  <path class="dg-s" d="M374 224 L146 142" />
  <path class="dg-m" d="M392 212 L378 224" />
  <rect x="236" y="164" width="42" height="14" class="dg-page" />
  <text class="dg-lbl dg-num" x="240" y="175">BEAM</text>

  <!-- ── the yoke ─────────────────────────────────────────────────────── -->
  <path class="dg-s" d="M114 122 L164 142" />
  <path class="dg-m" d="M122 125 V152 M156 139 V166" />
  <text class="dg-lbl dg-num" x="106" y="114" text-anchor="end">YOKE</text>
  <path class="dg-a" d="M104 132 H36" marker-end="url(#pl-ar)" />

  <text class="dg-lbl dg-key" x="30" y="196">0.5 HP FROM ONE OX</text>
  <text class="dg-lbl dg-num" x="30" y="210">0.07 HP FROM A PERSON</text>
  <text class="dg-lbl dg-soft" x="30" y="224">ROUGHLY EIGHT TO ONE</text>

  <text class="dg-lbl dg-soft" x="30" y="356">THE OX EATS GRASS, WHICH PEOPLE CANNOT DIGEST,</text>
  <text class="dg-lbl dg-soft" x="30" y="370">AND RETURNS MANURE TO THE FIELD IT JUST OPENED</text>

  <!-- ══ furrow in cross-section ════════════════════════════════════════ -->
  <path class="dg-m" d="M650 14 V386" />
  <text class="dg-lbl" x="678" y="24">FURROW IN CROSS-SECTION</text>

  <path class="dg-panel" d="M678 62 L716 62 L760 112 L804 62 L842 62 V132 H678 Z" />
  <path class="dg-s" d="M678 62 L716 62 L760 112 L804 62 L842 62" />
  <path class="dg-m" d="M678 132 H842" />
  <g class="dg-h">
    <path d="M690 132 l12 -12 M718 132 l12 -12 M746 132 l10 -10 M782 132 l12 -12 M814 132 l12 -12" />
  </g>
  <path class="dg-a" d="M734 88 q13 8 26 0 M742 74 q9 6 18 0" />
  <text class="dg-lbl dg-key" x="678" y="154">SOIL PARTS AND FALLS BACK IN</text>
  <text class="dg-lbl dg-soft" x="678" y="168">THE SOD IS NEVER TURNED OVER</text>

  <!-- ══ why the field is ploughed twice ════════════════════════════════ -->
  <text class="dg-lbl" x="678" y="212">WHY THE FIELD IS PLOUGHED TWICE</text>

  <rect x="678" y="226" width="112" height="112" class="dg-h" />
  <g class="dg-m">
    <path d="M678 242 H790 M678 258 H790 M678 274 H790 M678 290 H790 M678 306 H790 M678 322 H790" />
  </g>
  <text class="dg-lbl dg-soft" x="678" y="356">FIRST PASS</text>
  <text class="dg-lbl dg-soft" x="678" y="370">STRIPS LEFT UNBROKEN</text>

  <rect x="828" y="226" width="112" height="112" class="dg-h" />
  <g class="dg-m">
    <path d="M828 242 H940 M828 258 H940 M828 274 H940 M828 290 H940 M828 306 H940 M828 322 H940" />
  </g>
  <g class="dg-a">
    <path d="M844 226 V338 M860 226 V338 M876 226 V338 M892 226 V338 M908 226 V338 M924 226 V338" />
  </g>
  <text class="dg-lbl dg-key" x="828" y="356">SECOND PASS, AT 90°</text>
  <text class="dg-lbl dg-soft" x="828" y="370">NOW FULLY TILLED</text>
</svg>
