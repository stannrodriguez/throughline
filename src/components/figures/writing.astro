---
/**
 * Token to tablet. Counters sealed in a hollow clay bulla can only be read by
 * breaking it, so the shapes get pressed into the outside first — and once the
 * marks on the surface carry the account, the counters inside are redundant and
 * the sphere flattens into a tablet. Number and commodity are separate signs
 * from the start, which is why the tablets can be read without the language.
 */
---

<svg viewBox="0 0 960 400" role="img" aria-label="The sequence from clay counters through a sealed bulla to an impressed tablet, with the separate number and commodity notations">
  <defs>
    <marker id="wr-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-ink" />
    </marker>
  </defs>

  <!-- ── 1 · counters ─────────────────────────────────────────────────── -->
  <text class="dg-lbl dg-num" x="20" y="26">1 · COUNTERS</text>
  <rect x="20" y="34" width="206" height="150" class="dg-h" />
  <g>
    <path class="dg-m" d="M62 108 l14 -26 l14 26 Z" />
    <circle cx="128" cy="96" r="13" class="dg-m" />
    <path class="dg-m" d="M164 84 h26 v24 h-26 Z" />
    <path class="dg-m" d="M72 148 l12 -22 l12 22 Z" />
    <circle cx="134" cy="140" r="10" class="dg-m" />
    <path class="dg-m" d="M170 128 l16 10 l-16 10 l-16 -10 Z" />
  </g>
  <text class="dg-lbl" x="123" y="200" text-anchor="middle">ONE SHAPE PER COMMODITY</text>
  <text class="dg-lbl dg-soft" x="123" y="214" text-anchor="middle">COUNTED, NOT WRITTEN</text>
  <path class="dg-m" d="M232 108 H252" marker-end="url(#wr-ar)" />

  <!-- ── 2 · sealed in a bulla ────────────────────────────────────────── -->
  <text class="dg-lbl dg-num" x="258" y="26">2 · SEALED IN A BULLA</text>
  <rect x="258" y="34" width="206" height="150" class="dg-h" />
  <circle cx="361" cy="109" r="58" class="dg-panel" />
  <circle cx="361" cy="109" r="58" class="dg-s" />
  <g class="dg-d">
    <path d="M334 106 l10 -18 l10 18 Z" />
    <circle cx="382" cy="98" r="9" />
    <path d="M344 136 h20 v14 h-20 Z" />
    <path d="M382 128 l11 7 l-11 7 l-11 -7 Z" />
  </g>
  <text class="dg-lbl" x="361" y="200" text-anchor="middle">SEALED — TAMPER-PROOF</text>
  <text class="dg-lbl dg-soft" x="361" y="214" text-anchor="middle">AND UNREADABLE</text>
  <path class="dg-m" d="M470 108 H490" marker-end="url(#wr-ar)" />

  <!-- ── 3 · impressed on the outside ─────────────────────────────────── -->
  <text class="dg-lbl dg-num" x="496" y="26">3 · IMPRESSED OUTSIDE</text>
  <rect x="496" y="34" width="206" height="150" class="dg-h" />
  <circle cx="599" cy="109" r="58" class="dg-panel" />
  <circle cx="599" cy="109" r="58" class="dg-s" />
  <g class="dg-a">
    <path d="M572 100 l10 -18 l10 18 Z" />
    <circle cx="620" cy="92" r="9" />
    <path d="M580 128 h20 v14 h-20 Z" />
    <path d="M620 122 l11 7 l-11 7 l-11 -7 Z" />
  </g>
  <g class="dg-d">
    <circle cx="599" cy="109" r="34" />
  </g>
  <text class="dg-lbl dg-key" x="599" y="200" text-anchor="middle">THE SURFACE CARRIES THE COUNT</text>
  <text class="dg-lbl dg-soft" x="599" y="214" text-anchor="middle">THE COUNTERS ARE REDUNDANT</text>
  <path class="dg-m" d="M708 108 H728" marker-end="url(#wr-ar)" />

  <!-- ── 4 · the tablet ───────────────────────────────────────────────── -->
  <text class="dg-lbl dg-num" x="734" y="26">4 · THE TABLET</text>
  <rect x="734" y="34" width="206" height="150" class="dg-h" />
  <path class="dg-panel" d="M760 58 H914 C920 92, 920 126, 914 160 H760 C754 126, 754 92, 760 58 Z" />
  <path class="dg-s" d="M760 58 H914 C920 92, 920 126, 914 160 H760 C754 126, 754 92, 760 58 Z" />
  <path class="dg-h" d="M760 108 H914" />
  <g class="dg-a">
    <path d="M776 82 l8 -14 l8 14 Z" />
    <path d="M800 82 l8 -14 l8 14 Z" />
    <circle cx="836" cy="76" r="7" />
    <path d="M862 68 h16 v12 h-16 Z" />
    <path d="M776 138 l8 -14 l8 14 Z" />
    <circle cx="812" cy="132" r="7" />
    <path d="M840 124 l10 7 l-10 7 l-10 -7 Z" />
  </g>
  <text class="dg-lbl" x="837" y="200" text-anchor="middle">FLAT, STACKABLE, ARCHIVED</text>
  <text class="dg-lbl dg-soft" x="837" y="214" text-anchor="middle">BURNED, IT BECOMES CERAMIC</text>

  <!-- ══ the two notations ══════════════════════════════════════════════ -->
  <path class="dg-m" d="M20 250 H940" />
  <text class="dg-lbl" x="20" y="270">TWO NOTATIONS ON ONE TABLET</text>

  <!-- number -->
  <text class="dg-lbl dg-num" x="20" y="304">NUMBER — IMPRESSED WITH THE STYLUS END</text>
  <g class="dg-s">
    <path d="M34 336 l9 -16 l9 16 Z" />
    <circle cx="112" cy="330" r="10" />
    <path d="M172 342 l14 -24 l14 24 Z" />
  </g>
  <text class="dg-lbl dg-soft" x="43" y="364" text-anchor="middle">1</text>
  <text class="dg-lbl dg-soft" x="112" y="364" text-anchor="middle">10</text>
  <text class="dg-lbl dg-soft" x="186" y="364" text-anchor="middle">60</text>
  <text class="dg-lbl dg-soft" x="230" y="336">SIZE AND SHAPE CARRY THE VALUE</text>

  <!-- commodity -->
  <path class="dg-m" d="M500 286 V378" />
  <text class="dg-lbl dg-num" x="528" y="304">COMMODITY — DRAWN, THEN IMPRESSED</text>
  <g class="dg-s">
    <path d="M546 342 V318 M540 324 L546 314 L552 324 M538 332 h16" />
    <path d="M606 342 h26 v-14 c0 -10 -26 -10 -26 0 Z M612 328 v14" />
    <path d="M672 318 c-8 0 -12 6 -12 12 s4 12 12 12 h14 v-24 Z M660 324 l-8 -8 M660 336 l-8 8" />
  </g>
  <text class="dg-lbl dg-soft" x="546" y="364" text-anchor="middle">GRAIN</text>
  <text class="dg-lbl dg-soft" x="619" y="364" text-anchor="middle">JAR</text>
  <text class="dg-lbl dg-soft" x="673" y="364" text-anchor="middle">CATTLE</text>
  <text class="dg-lbl dg-soft" x="700" y="322">A SIGN FOR A THING, NOT A SOUND —</text>
  <text class="dg-lbl dg-soft" x="700" y="336">READABLE WITHOUT THE LANGUAGE,</text>
  <text class="dg-lbl dg-soft" x="700" y="350">UNTIL THE REBUS GIVES SIGNS SOUND</text>
</svg>
