    <text x="700" y="320" text-anchor="middle">20°</text>
    <text x="790" y="320" text-anchor="middle">400°</text>
    <text x="880" y="320" text-anchor="middle">800°</text>
  </g>
  <text class="dg-lbl" x="815" y="340" text-anchor="middle">TEMPERATURE AT THE CUTTING EDGE</text>

  <!-- carbon steel: high cold, gone by 250° -->
  <path class="dg-m" d="M700 210 C716 214, 728 226, 740 250 C752 274, 764 292, 780 298 H930" />
  <text class="dg-lbl dg-soft" x="708" y="204">CARBON STEEL</text>

  <!-- high-speed steel -->
  <path class="dg-m" d="M700 186 C730 188, 754 194, 780 208 C804 222, 822 254, 840 280 C856 294, 880 298, 930 299" />
  <text class="dg-lbl dg-num" x="746" y="184">HIGH-SPEED STEEL</text>

  <!-- cemented carbide: holds -->
  <path class="dg-a" d="M700 78 C740 80, 776 84, 810 92 C846 102, 878 118, 930 140" />
  <circle cx="700" cy="78" r="3.6" class="dg-accent" />
  <text class="dg-lbl dg-key" x="712" y="70">CEMENTED CARBIDE · ~1,800 HV</text>
  <text class="dg-lbl dg-soft" x="700" y="376">THE HARDNESS COMES FROM THE COVALENT CARBIDE</text>
  <text class="dg-lbl dg-soft" x="700" y="390">STRUCTURE, NOT A HEAT TREATMENT HEAT CAN UNDO —</text>
  <text class="dg-lbl dg-num" x="700" y="410">WHICH IS WHY IT IS STILL CUTTING WHERE STEEL HAS</text>
  <text class="dg-lbl dg-num" x="700" y="424">GONE SOFT, AND THE MACHINE CAN RUN 3–4× FASTER.</text>
</svg>
