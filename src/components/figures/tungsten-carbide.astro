---
/**
 * Two components failing in opposite ways, each covering for the other. Tungsten
 * carbide is about 1,800 HV against roughly 700 for hardened steel, and it keeps
 * that hardness hot because it comes from the covalent carbide structure rather
 * than from a heat treatment that can be undone. On its own it is brittle;
 * cobalt films between the grains absorb shock and arrest cracks. The curve is
 * the point: the useful comparison is hardness at temperature, not cold.
 */
---

<svg viewBox="0 0 960 440" role="img" aria-label="Tungsten carbide grains in a cobalt matrix, and hardness against temperature for carbon steel, high-speed steel and cemented carbide">
  <defs>
    <marker id="tc-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-ink" />
    </marker>
  </defs>

  <text class="dg-lbl" x="30" y="24">THE COMPOSITE · CARBIDE GRAINS IN A COBALT FILM</text>

  <!-- the microstructure -->
  <rect x="60" y="46" width="360" height="248" class="dg-tint" />
  <g class="dg-panel">
    <path d="M78 66 L134 60 L152 104 L108 122 L72 100 Z" />
    <path d="M168 58 L232 66 L244 112 L188 124 L158 96 Z" />
    <path d="M262 60 L326 56 L342 100 L296 120 L256 98 Z" />
    <path d="M352 66 L406 74 L410 118 L360 128 L342 100 Z" />
    <path d="M74 138 L130 132 L150 178 L98 192 L68 162 Z" />
    <path d="M166 140 L228 136 L246 184 L190 196 L158 170 Z" />
    <path d="M264 136 L324 142 L336 186 L286 198 L254 172 Z" />
    <path d="M354 142 L408 138 L412 190 L364 200 L346 172 Z" />
    <path d="M76 210 L134 204 L150 250 L100 268 L70 234 Z" />
    <path d="M168 212 L230 208 L244 254 L188 268 L158 240 Z" />
    <path d="M262 210 L326 214 L338 258 L288 272 L256 244 Z" />
    <path d="M352 214 L406 210 L412 260 L362 272 L344 240 Z" />
  </g>
  <g class="dg-s">
    <path d="M78 66 L134 60 L152 104 L108 122 L72 100 Z" />
    <path d="M168 58 L232 66 L244 112 L188 124 L158 96 Z" />
    <path d="M262 60 L326 56 L342 100 L296 120 L256 98 Z" />
    <path d="M352 66 L406 74 L410 118 L360 128 L342 100 Z" />
    <path d="M74 138 L130 132 L150 178 L98 192 L68 162 Z" />
    <path d="M166 140 L228 136 L246 184 L190 196 L158 170 Z" />
    <path d="M264 136 L324 142 L336 186 L286 198 L254 172 Z" />
    <path d="M354 142 L408 138 L412 190 L364 200 L346 172 Z" />
    <path d="M76 210 L134 204 L150 250 L100 268 L70 234 Z" />
    <path d="M168 212 L230 208 L244 254 L188 268 L158 240 Z" />
    <path d="M262 210 L326 214 L338 258 L288 272 L256 244 Z" />
    <path d="M352 214 L406 210 L412 260 L362 272 L344 240 Z" />
  </g>

  <path class="dg-m" d="M448 90 L344 84" />
  <text class="dg-lbl dg-num" x="456" y="94">CARBIDE GRAINS</text>
  <text class="dg-lbl dg-soft" x="456" y="108">~1,800 HV · BRITTLE</text>
  <path class="dg-m" d="M448 176 L338 190" />
  <text class="dg-lbl dg-key" x="456" y="180">COBALT BETWEEN THEM</text>
  <text class="dg-lbl dg-soft" x="456" y="194">SOFT, TOUGH, THIN —</text>
  <text class="dg-lbl dg-soft" x="456" y="208">IT ARRESTS CRACKS</text>

  <text class="dg-lbl dg-num" x="30" y="320">VARYING THE COBALT FRACTION TRADES HARDNESS AGAINST TOUGHNESS,</text>
  <text class="dg-lbl dg-num" x="30" y="334">WHICH IS HOW GRADES ARE SPECIFIED.</text>
  <text class="dg-lbl dg-soft" x="30" y="360">THE METHOD MATTERS AS MUCH AS THE MATERIAL. SINTERING — FORMING A</text>
  <text class="dg-lbl dg-soft" x="30" y="374">SHAPE FROM POWDER AND CONSOLIDATING IT BELOW THE MELTING POINT —</text>
  <text class="dg-lbl dg-soft" x="30" y="388">MAKES IT POSSIBLE TO WORK WITH SUBSTANCES THAT CANNOT BE MELTED</text>
  <text class="dg-lbl dg-soft" x="30" y="402">AT ALL, AND BECOMES THE ROUTE TO TECHNICAL CERAMICS, MAGNETS</text>
  <text class="dg-lbl dg-soft" x="30" y="416">AND REFRACTORY METALS.</text>
  <text class="dg-lbl dg-num" x="30" y="436">WIDIA, 1927 · 3 TO 4 TIMES THE CUTTING SPEED</text>

  <!-- ══ hot hardness ═══════════════════════════════════════════════════ -->
  <path class="dg-m" d="M620 14 V430" />

  <path class="dg-h" d="M700 96 H930 M700 164 H930 M700 232 H930" />
  <path class="dg-h" d="M760 60 V300 M820 60 V300 M880 60 V300" />
  <path class="dg-s" d="M700 60 V300 H930" />

  <text class="dg-lbl" x="700" y="46">HARDNESS, HV</text>
  <g class="dg-num">
    <text x="692" y="64" text-anchor="end">2,000</text>
    <text x="692" y="100" text-anchor="end">1,600</text>
    <text x="692" y="168" text-anchor="end">1,000</text>
    <text x="692" y="236" text-anchor="end">500</text>
    <text x="692" y="304" text-anchor="end">0</text>
  </g>
  <path class="dg-m" d="M700 300 v5 M760 300 v5 M820 300 v5 M880 300 v5 M930 300 v5" />
