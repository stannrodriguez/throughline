---
/**
 * Newfoundland is well below Cornwall's horizon, so on the physics people had in
 * 1901 the signal should not have arrived. A conducting layer in the upper
 * atmosphere reflects long waves back down and the wave bounces between it and
 * the ocean, following the curve. The band below is the structural point: the
 * signal has no dedicated path, so everyone in range receives it — which makes
 * broadcasting possible and makes the spectrum a resource that must be allocated.
 */
---

<svg viewBox="0 0 960 620" role="img" aria-label="A line-of-sight path against an ionospheric reflection over 3,500 km, and the spectrum as a shared and allocated resource">
  <defs>
    <marker id="rd-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-ink" />
    </marker>
    <marker id="rd-ar-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-accent" />
    </marker>
  </defs>

  <text class="dg-lbl" x="30" y="24">12 DECEMBER 1901 · ABOUT 3,500 KM, AND THE LETTER S</text>

  <!-- the curve of the Earth -->
  <path class="dg-panel" d="M20 400 C160 292, 400 246, 620 246 C700 246, 800 258, 900 280 V400 Z" />
  <path class="dg-s" d="M20 400 C160 292, 400 246, 620 246 C700 246, 800 258, 900 280" />

  <!-- the ionosphere -->
  <path class="dg-a-d" d="M40 236 C180 124, 400 78, 620 78 C700 78, 800 90, 900 114" />
  <text class="dg-lbl dg-key" x="520" y="68" text-anchor="middle">A CONDUCTING LAYER IN THE UPPER ATMOSPHERE</text>

  <!-- transmitter, Cornwall -->
  <path class="dg-s" d="M148 292 V218" />
  <path class="dg-m" d="M132 292 L148 264 M164 292 L148 264" />
  <path class="dg-m" d="M138 302 h20" />
  <text class="dg-lbl dg-num" x="118" y="328" text-anchor="middle">POLDHU</text>
  <text class="dg-lbl dg-soft" x="118" y="342" text-anchor="middle">EARTHED VERTICAL AERIAL</text>

  <!-- receiver, Newfoundland -->
  <path class="dg-s" d="M810 262 V192" />
  <path class="dg-m" d="M794 262 L810 236 M826 262 L810 236" />
  <path class="dg-m" d="M800 272 h20" />
  <text class="dg-lbl dg-num" x="836" y="248">SIGNAL HILL</text>
  <text class="dg-lbl dg-soft" x="836" y="262">BELOW THE HORIZON</text>

  <!-- line of sight: leaves the Earth -->
  <path class="dg-d" d="M148 218 L620 148" />
  <path class="dg-m" d="M620 148 L706 136" marker-end="url(#rd-ar)" />
  <text class="dg-lbl dg-soft" x="556" y="138">LINE OF SIGHT</text>
  <text class="dg-lbl dg-soft" x="716" y="122">STRAIGHT ON, AND GONE</text>

  <!-- the bounce -->
  <path class="dg-a" d="M148 218 L432 96" marker-end="url(#rd-ar-a)" />
  <path class="dg-a" d="M432 96 L640 228" marker-end="url(#rd-ar-a)" />
  <path class="dg-a" d="M640 228 L740 126" marker-end="url(#rd-ar-a)" />
  <path class="dg-a" d="M740 126 L810 192" marker-end="url(#rd-ar-a)" />


  <text class="dg-lbl dg-key" x="30" y="354">THE WAVE BOUNCES BETWEEN THE LAYER AND THE OCEAN, AND FOLLOWS THE CURVE.</text>
  <text class="dg-lbl dg-soft" x="30" y="376">HEAVISIDE AND KENNELLY PROPOSE THE LAYER THE FOLLOWING YEAR, AND IT IS CONFIRMED IN THE 1920s.</text>
  <text class="dg-lbl dg-num" x="30" y="396">MARCONI SUCCEEDED PARTLY BY NOT KNOWING IT WAS IMPOSSIBLE.</text>

  <!-- ══ no dedicated path ══════════════════════════════════════════════ -->
  <path class="dg-m" d="M30 420 H930" />
  <text class="dg-lbl" x="30" y="442">AND THE DEEPER STRUCTURE · THE SIGNAL HAS NO PATH OF ITS OWN</text>

  <!-- a wire: two specified points -->
  <text class="dg-lbl dg-num" x="30" y="474">A WIRE</text>
  <circle cx="70" cy="518" r="10" class="dg-ink" />
  <path class="dg-s" d="M80 518 H316" marker-end="url(#rd-ar)" />
  <circle cx="330" cy="518" r="10" class="dg-page" />
  <circle cx="330" cy="518" r="10" class="dg-s" />
  <text class="dg-lbl dg-soft" x="30" y="560">TWO SPECIFIED POINTS, AND IT CARRIES</text>
  <text class="dg-lbl dg-soft" x="30" y="574">WHATEVER IS PUT INTO IT</text>

  <!-- radio: everyone in range -->
  <path class="dg-m" d="M400 456 V590" />
  <text class="dg-lbl dg-num" x="430" y="468">A TRANSMISSION</text>
  <circle cx="500" cy="518" r="10" class="dg-accent" />
  <g class="dg-a-d">
    <circle cx="500" cy="518" r="30" />
    <circle cx="500" cy="518" r="54" />
    <circle cx="500" cy="518" r="78" />
  </g>
  <g class="dg-m">
    <circle cx="560" cy="482" r="6" /><circle cx="572" cy="546" r="6" />
    <circle cx="452" cy="470" r="6" /><circle cx="436" cy="562" r="6" />
    <circle cx="518" cy="586" r="6" /><circle cx="500" cy="450" r="6" />
  </g>
  <text class="dg-lbl dg-key" x="600" y="500">EVERYONE IN RANGE GETS IT.</text>
  <text class="dg-lbl dg-soft" x="600" y="514">THAT MAKES BROADCASTING POSSIBLE —</text>
  <text class="dg-lbl dg-soft" x="600" y="528">A NEW KIND OF COMMUNICATION, NOT A</text>
  <text class="dg-lbl dg-soft" x="600" y="542">CHEAPER VERSION OF AN OLD ONE.</text>

  <!-- the spectrum, allocated -->
  <path class="dg-s" d="M600 566 H930" />
  <g>
    <rect x="600" y="566" width="60" height="16" class="dg-panel" />
    <rect x="662" y="566" width="82" height="16" class="dg-tint" />
    <rect x="746" y="566" width="54" height="16" class="dg-panel" />
    <rect x="802" y="566" width="128" height="16" class="dg-tint" />
  </g>
  <g class="dg-m">
    <path d="M600 566 V582 M660 566 V582 M744 566 V582 M800 566 V582 M930 566 V582" />
  </g>
  <text class="dg-lbl dg-soft" x="600" y="598">TWO STATIONS ON ONE FREQUENCY INTERFERE, SO THE STATE</text>
  <text class="dg-lbl dg-soft" x="600" y="612">ALLOCATES BANDS — AND RADIO ARRIVES ALREADY GOVERNED.</text>
</svg>
