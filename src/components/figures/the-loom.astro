---
/**
 * Plain weave in section — one warp passing alternately over and under wefts
 * seen end-on — then the mechanism that makes it fast: a heddle rod lifting
 * every second warp so the whole shed opens at once and the shuttle crosses in
 * one throw. Warp-weighted loom in elevation at right, where gravity supplies
 * the tension a frame would otherwise have to hold.
 */
---

<svg viewBox="0 0 960 400" role="img" aria-label="Plain weave in section, the shed opened by a heddle rod with a shuttle passing, and a warp-weighted loom in elevation">
  <defs>
    <marker id="lm-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-ink" />
    </marker>
    <marker id="lm-ar-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-accent" />
    </marker>
  </defs>

  <!-- ══ plain weave in section ══════════════════════════════════════════ -->
  <text class="dg-lbl" x="30" y="24">PLAIN WEAVE · WEFTS END-ON, ONE WARP TRACED</text>

  <g>
    <circle cx="70" cy="74" r="11" class="dg-panel" /><circle cx="70" cy="74" r="11" class="dg-m" />
    <circle cx="114" cy="74" r="11" class="dg-panel" /><circle cx="114" cy="74" r="11" class="dg-m" />
    <circle cx="158" cy="74" r="11" class="dg-panel" /><circle cx="158" cy="74" r="11" class="dg-m" />
    <circle cx="202" cy="74" r="11" class="dg-panel" /><circle cx="202" cy="74" r="11" class="dg-m" />
    <circle cx="246" cy="74" r="11" class="dg-panel" /><circle cx="246" cy="74" r="11" class="dg-m" />
    <circle cx="290" cy="74" r="11" class="dg-panel" /><circle cx="290" cy="74" r="11" class="dg-m" />
    <circle cx="334" cy="74" r="11" class="dg-panel" /><circle cx="334" cy="74" r="11" class="dg-m" />
    <circle cx="378" cy="74" r="11" class="dg-panel" /><circle cx="378" cy="74" r="11" class="dg-m" />
  </g>
  <path
    class="dg-a"
    d="M42 74 C50 74, 56 60, 70 60 C84 60, 90 88, 114 88 C138 88, 144 60, 158 60
       C172 60, 178 88, 202 88 C226 88, 232 60, 246 60 C260 60, 266 88, 290 88
       C314 88, 320 60, 334 60 C348 60, 354 88, 378 88 C394 88, 398 80, 406 76"
  />
  <text class="dg-lbl dg-key" x="418" y="66">ONE WARP, OVER AND UNDER</text>
  <text class="dg-lbl" x="418" y="90">WEFTS, SEEN END-ON</text>
  <text class="dg-lbl dg-soft" x="30" y="118">EVERY THREAD IS HELD BY THE ONES CROSSING IT · THE LOAD SPREADS EITHER WAY</text>

  <!-- ══ the shed ════════════════════════════════════════════════════════ -->
  <text class="dg-lbl" x="30" y="164">THE SHED, OPENED IN ONE MOTION</text>

  <path class="dg-s" d="M56 190 V320" />
  <path class="dg-s" d="M540 214 V296" />
  <text class="dg-lbl dg-soft" x="56" y="338">WARP BEAM</text>
  <text class="dg-lbl dg-soft" x="540" y="338" text-anchor="end">CLOTH</text>

  <!-- warps that stay down -->
  <g class="dg-m">
    <path d="M56 248 H236 L308 282 L470 258 H540" />
    <path d="M56 262 H236 L308 290 L470 264 H540" />
    <path d="M56 276 H236 L308 298 L470 270 H540" />
  </g>
  <!-- warps lifted by the heddle rod -->
  <g class="dg-a">
    <path d="M56 242 H236 L308 218 L470 252 H540" />
    <path d="M56 256 H236 L308 226 L470 258 H540" />
    <path d="M56 270 H236 L308 234 L470 264 H540" />
  </g>

  <!-- heddle rod -->
  <path class="dg-s" d="M296 200 H320" />
  <circle cx="308" cy="200" r="6" class="dg-page" />
  <circle cx="308" cy="200" r="6" class="dg-s" />
  <path class="dg-m" d="M300 206 V220 M316 206 V222" />
  <path class="dg-a" d="M308 192 V170" marker-end="url(#lm-ar-a)" />
  <rect x="326" y="162" width="230" height="14" class="dg-page" />
  <text class="dg-lbl dg-key" x="330" y="173">HEDDLE ROD LIFTS EVERY SECOND WARP</text>

  <!-- the shuttle in the opening -->
  <path class="dg-ink" d="M356 256 l30 -6 l30 6 l-30 6 Z" />
  <path class="dg-s" d="M424 256 H468" marker-end="url(#lm-ar)" />
  <rect x="352" y="232" width="70" height="14" class="dg-page" />
  <text class="dg-lbl dg-num" x="386" y="243" text-anchor="middle">SHUTTLE</text>
  <text class="dg-lbl dg-soft" x="30" y="366">ONE THROW LAYS ONE WEFT ACROSS THE WHOLE WIDTH</text>

  <!-- ══ warp-weighted loom ═════════════════════════════════════════════ -->
  <path class="dg-m" d="M594 14 V386" />
  <text class="dg-lbl" x="622" y="24">WARP-WEIGHTED LOOM, ELEVATION</text>

  <path class="dg-s" d="M644 52 H928" />
  <path class="dg-s" d="M672 52 V326 M900 52 V326" />
  <rect x="820" y="36" width="110" height="14" class="dg-page" />
  <text class="dg-lbl dg-soft" x="928" y="47" text-anchor="end">CLOTH BEAM</text>

  <rect x="686" y="60" width="200" height="44" class="dg-panel" />
  <g class="dg-h">
    <path d="M686 70 H886 M686 80 H886 M686 90 H886 M686 100 H886" />
  </g>
  <text class="dg-lbl" x="786" y="86" text-anchor="middle">CLOTH GROWS DOWNWARD</text>

  <path class="dg-s" d="M672 134 H900" />
  <path class="dg-a" d="M672 176 H900" />
  <!-- back layer of warps -->
  <g class="dg-m">
    <path d="M700 104 V134 C700 154, 696 170, 696 288" />
    <path d="M728 104 V134 C728 154, 724 170, 724 288" />
    <path d="M756 104 V134 C756 154, 752 170, 752 288" />
    <path d="M784 104 V134 C784 154, 780 170, 780 288" />
    <path d="M812 104 V134 C812 154, 808 170, 808 288" />
    <path d="M840 104 V134 C840 154, 836 170, 836 288" />
    <path d="M868 104 V134 C868 154, 864 170, 864 288" />
  </g>
  <!-- front layer, carried on the heddle rod -->
  <g class="dg-a">
    <path d="M714 104 V176 C714 198, 720 214, 720 288" />
    <path d="M742 104 V176 C742 198, 748 214, 748 288" />
    <path d="M770 104 V176 C770 198, 776 214, 776 288" />
    <path d="M798 104 V176 C798 198, 804 214, 804 288" />
    <path d="M826 104 V176 C826 198, 832 214, 832 288" />
    <path d="M854 104 V176 C854 198, 860 214, 860 288" />
  </g>

  <g>
    <path class="dg-panel" d="M690 288 h12 l5 30 h-22 Z" /><path class="dg-m" d="M690 288 h12 l5 30 h-22 Z" />
    <path class="dg-panel" d="M746 288 h12 l5 30 h-22 Z" /><path class="dg-m" d="M746 288 h12 l5 30 h-22 Z" />
    <path class="dg-panel" d="M802 288 h12 l5 30 h-22 Z" /><path class="dg-m" d="M802 288 h12 l5 30 h-22 Z" />
    <path class="dg-panel" d="M858 288 h12 l5 30 h-22 Z" /><path class="dg-m" d="M858 288 h12 l5 30 h-22 Z" />
  </g>
  <rect x="686" y="118" width="66" height="14" class="dg-page" />
  <text class="dg-lbl dg-soft" x="690" y="129">SHED ROD</text>

  <rect x="686" y="160" width="80" height="14" class="dg-page" />
  <text class="dg-lbl dg-key" x="690" y="171">HEDDLE ROD</text>

  <text class="dg-lbl dg-num" x="786" y="352" text-anchor="middle">FIRED CLAY WEIGHTS HOLD THE WARP TAUT</text>
  <text class="dg-lbl dg-soft" x="786" y="366" text-anchor="middle">GRAVITY DOES WHAT A FRAME WOULD HAVE TO</text>
</svg>
