---
/**
 * H4, and the three perturbations Harrison attacked physically rather than
 * correcting afterward: heat softening the balance spring, the roll of the deck,
 * and falling drive force as the mainspring runs down. The right panel is the
 * arithmetic that makes the result legible — the sun moves 15° an hour, so an
 * hour of clock error is 15° of longitude, and a second is a quarter nautical
 * mile at the equator.
 */
---

<svg viewBox="0 0 960 440" role="img" aria-label="Cutaway of Harrison's H4 showing the bimetallic strip, remontoire and 5 Hz balance, with the 15 degrees per hour relation between clock error and longitude">
  <defs>
    <marker id="mc-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-ink" />
    </marker>
  </defs>

  <text class="dg-lbl" x="30" y="24">H4 · CUTAWAY, 1761</text>

  <!-- case -->
  <circle cx="230" cy="164" r="126" class="dg-h" />
  <circle cx="230" cy="164" r="118" class="dg-s" />

  <!-- balance wheel -->
  <circle cx="230" cy="164" r="76" class="dg-s" />
  <circle cx="230" cy="164" r="6" class="dg-ink" />
  <g class="dg-m">
    <path d="M230 88 V240 M154 164 H306 M176 110 L284 218 M284 110 L176 218" />
  </g>

  <!-- balance spring, a flat spiral inside the wheel -->
  <path
    class="dg-a"
    d="M230 164 C230 154, 242 152, 247 159 C254 168, 247 181, 234 181
       C217 181, 209 166, 214 151 C221 132, 244 127, 261 139
       C281 152, 283 180, 265 197"
  />

  <!-- remontoire -->
  <circle cx="230" cy="164" r="34" class="dg-h" />
  <path class="dg-s" d="M200 148 A 36 36 0 0 1 260 148" />

  <!-- numbered tags -->
  <g>
    <circle cx="278" cy="204" r="10" class="dg-page" /><circle cx="278" cy="204" r="10" class="dg-s" />
    <text class="dg-lbl dg-num" x="278" y="208" text-anchor="middle">1</text>
    <circle cx="230" cy="196" r="10" class="dg-page" /><circle cx="230" cy="196" r="10" class="dg-s" />
    <text class="dg-lbl dg-num" x="230" y="200" text-anchor="middle">2</text>
    <circle cx="230" cy="128" r="10" class="dg-page" /><circle cx="230" cy="128" r="10" class="dg-s" />
    <text class="dg-lbl dg-num" x="230" y="132" text-anchor="middle">3</text>
  </g>

  <!-- bimetallic strip, on the spring, drawn outside the wheel -->
  <path class="dg-s" d="M266 198 L318 226" />
  <path class="dg-s" d="M318 226 C336 236, 340 254, 330 270" />
  <path class="dg-m" d="M322 222 C340 232, 344 252, 334 268" />

  <text class="dg-lbl dg-num" x="30" y="318">EACH ERROR IS SOMETHING PERTURBING THE OSCILLATOR,</text>
  <text class="dg-lbl dg-num" x="30" y="332">AND EACH IS FIXED IN THE MECHANISM, NOT IN THE LOG</text>

  <text class="dg-lbl dg-key" x="30" y="360">1 · BIMETALLIC STRIP</text>
  <text class="dg-lbl dg-soft" x="30" y="374">BENDS WITH TEMPERATURE TO SHORTEN THE BALANCE SPRING</text>
  <text class="dg-lbl dg-soft" x="30" y="388">BY EXACTLY AS MUCH AS HEAT LENGTHENS IT</text>

  <text class="dg-lbl dg-key" x="30" y="410">2 · BALANCE AT 5 Hz</text>
  <text class="dg-lbl dg-soft" x="30" y="424">FAST ENOUGH THAT THE ROLL OF THE DECK AVERAGES OUT</text>
  <text class="dg-lbl dg-soft" x="30" y="438">INSTEAD OF ACCUMULATING</text>

  <!-- ══ 15° an hour ════════════════════════════════════════════════════ -->
  <path class="dg-m" d="M470 14 V430" />
  <text class="dg-lbl" x="500" y="24">THE SUN MOVES 15° OF LONGITUDE AN HOUR</text>

  <text class="dg-lbl dg-key" x="500" y="56">3 · REMONTOIRE</text>
  <text class="dg-lbl dg-soft" x="500" y="70">A SMALL SPRING REWOUND EVERY FEW SECONDS,</text>
  <text class="dg-lbl dg-soft" x="500" y="84">SO THE DRIVE FORCE NEVER FALLS AS IT RUNS DOWN</text>

  <!-- the globe -->
  <circle cx="690" cy="212" r="84" class="dg-s" />
  <path class="dg-h" d="M690 128 V296" />
  <g class="dg-h">
    <path d="M690 128 C658 158, 658 266, 690 296 M690 128 C722 158, 722 266, 690 296" />
    <path d="M690 128 C626 160, 626 264, 690 296 M690 128 C754 160, 754 264, 690 296" />
  </g>
  <path class="dg-m" d="M606 212 H774" />
  <path class="dg-a" d="M690 212 L690 128" />
  <path class="dg-a" d="M690 212 L768 184" />
  <path class="dg-a" d="M718 149 A 34 34 0 0 0 703 138" />
  <text class="dg-lbl dg-key" x="782" y="180">15° · ONE HOUR</text>
  <text class="dg-lbl dg-soft" x="500" y="322" >ONE HOUR OF CLOCK ERROR IS FIFTEEN DEGREES OF LONGITUDE</text>

  <!-- the arithmetic -->
  <path class="dg-m" d="M500 342 H930" />
  <text class="dg-lbl" x="500" y="362">AT THE EQUATOR</text>
  <text class="dg-lbl dg-num" x="500" y="384">1 SECOND OF CLOCK ERROR  =  ¼ NAUTICAL MILE</text>
  <text class="dg-lbl dg-key" x="500" y="404">5 SECONDS IN 81 DAYS  =  ABOUT 2 KM, ATLANTIC CROSSED</text>
  <text class="dg-lbl dg-soft" x="500" y="424">AN ORDER OF MAGNITUDE INSIDE THE PRIZE'S HALF-DEGREE</text>
</svg>
