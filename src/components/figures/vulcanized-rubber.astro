---
/**
 * Chains, before and after. Raw polyisoprene is a tangle held together by
 * nothing but friction, so under load the chains slide and the deformation is
 * permanent, and heat only makes the sliding easier. Sulphur bridges turn the
 * tangle into one connected network: stretching uncoils the chains but cannot
 * let them slip, and flow would now require breaking chemical bonds.
 */
---

<svg viewBox="0 0 960 460" role="img" aria-label="Tangled unlinked polyisoprene chains sliding under load against a sulphur-bridged network that recovers, and the usable temperature band">
  <defs>
    <marker id="vr-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-ink" />
    </marker>
  </defs>

  <!-- ══ raw ════════════════════════════════════════════════════════════ -->
  <text class="dg-lbl dg-num" x="30" y="24">RAW · NOTHING BUT FRICTION BETWEEN THE CHAINS</text>

  <text class="dg-lbl dg-soft" x="30" y="52">AT REST</text>
  <rect x="30" y="62" width="180" height="120" class="dg-h" />
  <g class="dg-m">
    <path d="M44 92 C70 74, 88 110, 116 92 C142 76, 166 108, 196 90" />
    <path d="M42 122 C66 104, 92 140, 118 120 C144 102, 170 138, 198 118" />
    <path d="M46 152 C72 134, 90 170, 118 150 C146 132, 168 166, 196 148" />
    <path d="M58 70 C66 100, 50 130, 62 172" />
    <path d="M120 68 C130 100, 112 132, 124 174" />
    <path d="M180 70 C190 100, 172 132, 184 172" />
  </g>

  <path class="dg-m" d="M226 122 H250" marker-end="url(#vr-ar)" />
  <text class="dg-lbl dg-soft" x="266" y="52">PULLED, AND RELEASED</text>
  <rect x="266" y="62" width="180" height="120" class="dg-h" />
  <g class="dg-m">
    <path d="M278 92 H436" />
    <path d="M278 122 H436" />
    <path d="M278 152 H436" />
    <path d="M300 70 C304 100, 296 132, 302 174" />
    <path d="M360 74 C366 104, 356 136, 362 176" />
    <path d="M416 70 C420 100, 412 132, 418 174" />
  </g>
  <path class="dg-a" d="M338 200 H420" marker-end="url(#vr-ar)" />
  <path class="dg-a" d="M338 200 H256" marker-end="url(#vr-ar)" />
  <text class="dg-lbl dg-key" x="266" y="222">THE CHAINS SLID PAST EACH OTHER —</text>
  <text class="dg-lbl dg-key" x="266" y="236">THE SHAPE DOES NOT COME BACK</text>
  <text class="dg-lbl dg-soft" x="30" y="222">HEAT IT AND THE SLIDING</text>
  <text class="dg-lbl dg-soft" x="30" y="236">GETS EASIER, UNTIL IT FLOWS</text>

  <!-- ══ vulcanised ═════════════════════════════════════════════════════ -->
  <path class="dg-m" d="M30 264 H500" />
  <text class="dg-lbl dg-num" x="30" y="286">VULCANISED · A FEW PER CENT SULPHUR</text>

  <text class="dg-lbl dg-soft" x="30" y="312">AT REST</text>
  <rect x="30" y="322" width="180" height="106" class="dg-h" />
  <g class="dg-m">
    <path d="M44 348 C70 332, 88 366, 116 348 C142 332, 166 364, 196 346" />
    <path d="M42 378 C66 360, 92 396, 118 376 C144 358, 170 394, 198 374" />
    <path d="M46 408 C72 392, 90 424, 118 406 C146 390, 168 420, 196 404" />
  </g>
  <g class="dg-a">
    <path d="M70 342 V372 M124 350 V380 M176 348 V376 M96 374 V404 M150 378 V406" />
  </g>

  <path class="dg-m" d="M226 372 H250" marker-end="url(#vr-ar)" />
  <text class="dg-lbl dg-soft" x="266" y="312">PULLED, AND RELEASED</text>
  <rect x="266" y="322" width="180" height="106" class="dg-h" />
  <g class="dg-m">
    <path d="M278 348 C310 340, 344 356, 380 346 C404 340, 420 350, 436 346" />
    <path d="M278 378 C310 370, 344 386, 380 376 C404 370, 420 380, 436 376" />
    <path d="M278 408 C310 400, 344 416, 380 406 C404 400, 420 410, 436 406" />
  </g>
  <g class="dg-a">
    <path d="M306 344 V374 M360 350 V380 M412 346 V376 M332 376 V406 M386 380 V408" />
  </g>
  <text class="dg-lbl dg-key" x="266" y="446">THE BRIDGES HOLD — IT RETURNS TO SHAPE</text>

  <!-- ══ the band ═══════════════════════════════════════════════════════ -->
  <path class="dg-m" d="M540 14 V450" />
  <text class="dg-lbl" x="568" y="24">WHAT SULPHUR BUYS</text>

  <text class="dg-lbl dg-num" x="568" y="56">STRETCHING UNCOILS THE CHAINS BUT CANNOT LET THEM SLIP —</text>
  <text class="dg-lbl dg-num" x="568" y="70">SO THE MATERIAL RETURNS TO ITS SHAPE.</text>
  <text class="dg-lbl dg-soft" x="568" y="92">AND FLOW WOULD NOW REQUIRE BREAKING CHEMICAL BONDS,</text>
  <text class="dg-lbl dg-soft" x="568" y="106">NOT MERELY OVERCOMING FRICTION.</text>

  <!-- usable temperature band -->
  <path class="dg-m" d="M568 200 H930" />
  <path class="dg-m" d="M568 194 V206 M930 194 V206" />
  <rect x="600" y="182" width="242" height="36" class="dg-tint" />
  <path class="dg-a" d="M600 182 V218 M842 182 V218" />
  <g class="dg-num">
    <text x="600" y="242" text-anchor="middle">−30°</text>
    <text x="842" y="242" text-anchor="middle">100°</text>
  </g>
  <text class="dg-lbl dg-key" x="721" y="172" text-anchor="middle">A SOFT ELASTIC SOLID, USABLE HERE</text>
  <text class="dg-lbl dg-soft" x="568" y="150">TEMPERATURE →</text>

  <!-- more sulphur -->
  <path class="dg-m" d="M568 274 H930" />
  <text class="dg-lbl" x="568" y="296">THE SAME REACTION, TAKEN FURTHER</text>
  <rect x="568" y="308" width="60" height="14" class="dg-accent" />
  <text class="dg-lbl dg-key" x="638" y="319">A FEW % SULPHUR · SOFT, ELASTIC</text>
  <rect x="568" y="330" width="300" height="14" class="dg-ink" />
  <text class="dg-lbl dg-num" x="568" y="362">A GREAT DEAL MORE · EBONITE, A HARD RIGID PLASTIC</text>

  <text class="dg-lbl dg-soft" x="568" y="398">THE WORD WAS HANCOCK'S COLLEAGUE'S, AFTER THE ROMAN GOD</text>
  <text class="dg-lbl dg-soft" x="568" y="412">OF FIRE, AND IT NAMED A PROCESS NOBODY COULD EXPLAIN.</text>
  <text class="dg-lbl dg-soft" x="568" y="426">STAUDINGER SHOWS POLYMERS ARE LONG MOLECULES AT ALL 80 YEARS ON.</text>
</svg>
