---
/**
 * Both electrodes are layered crystals, and the ions are guests in the space
 * between the sheets. Charging drives them out of the oxide and in between the
 * graphite; discharging reverses it; the hosts expand and contract by under ten
 * percent and are otherwise unchanged. The bars below are why silicon, which
 * would hold ten times as much lithium, tears itself apart instead.
 */
---

<svg viewBox="0 0 960 490" role="img" aria-label="Lithium ions moving between the layers of a cobalt oxide cathode and a graphite anode, the lattice expansion of graphite against silicon, and the surface film that grows with cycling">
  <defs>
    <marker id="li-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-ink" />
    </marker>
    <marker id="li-ar-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-accent" />
    </marker>
  </defs>

  <text class="dg-lbl" x="30" y="30">THE IONS ARE GUESTS BETWEEN THE SHEETS</text>

  <!-- the cathode -->
  <g>
    <path class="dg-panel" d="M60 76 H220 V88 H60 Z M60 106 H220 V118 H60 Z M60 136 H220 V148 H60 Z
                              M60 166 H220 V178 H60 Z M60 196 H220 V208 H60 Z M60 226 H220 V238 H60 Z" />
    <path class="dg-m" d="M60 76 H220 V88 H60 Z M60 106 H220 V118 H60 Z M60 136 H220 V148 H60 Z
                          M60 166 H220 V178 H60 Z M60 196 H220 V208 H60 Z M60 226 H220 V238 H60 Z" />
  </g>
  <g class="dg-accent">
    <circle cx="80" cy="97" r="4" /><circle cx="112" cy="97" r="4" /><circle cx="144" cy="97" r="4" />
    <circle cx="176" cy="97" r="4" /><circle cx="208" cy="97" r="4" />
    <circle cx="80" cy="157" r="4" /><circle cx="112" cy="157" r="4" /><circle cx="144" cy="157" r="4" />
    <circle cx="176" cy="157" r="4" /><circle cx="208" cy="157" r="4" />
    <circle cx="80" cy="217" r="4" /><circle cx="112" cy="217" r="4" /><circle cx="144" cy="217" r="4" />
    <circle cx="176" cy="217" r="4" /><circle cx="208" cy="217" r="4" />
  </g>
  <text class="dg-lbl dg-num" x="60" y="266">LAYERED COBALT OXIDE</text>

  <!-- the electrolyte -->
  <path class="dg-d" d="M250 76 V238 M280 76 V238 M310 76 V238 M340 76 V238 M370 76 V238" />
  <path class="dg-page" d="M266 152 H354 V170 H266 Z" />
  <text class="dg-lbl dg-soft" x="310" y="164" text-anchor="middle">ELECTROLYTE</text>

  <!-- the anode -->
  <g>
    <path class="dg-panel" d="M400 76 H560 V88 H400 Z M400 106 H560 V118 H400 Z M400 136 H560 V148 H400 Z
                              M400 166 H560 V178 H400 Z M400 196 H560 V208 H400 Z M400 226 H560 V238 H400 Z" />
    <path class="dg-m" d="M400 76 H560 V88 H400 Z M400 106 H560 V118 H400 Z M400 136 H560 V148 H400 Z
                          M400 166 H560 V178 H400 Z M400 196 H560 V208 H400 Z M400 226 H560 V238 H400 Z" />
  </g>
  <g class="dg-accent">
    <circle cx="420" cy="127" r="4" /><circle cx="452" cy="127" r="4" /><circle cx="484" cy="127" r="4" />
    <circle cx="516" cy="127" r="4" /><circle cx="548" cy="127" r="4" />
    <circle cx="420" cy="187" r="4" /><circle cx="452" cy="187" r="4" /><circle cx="484" cy="187" r="4" />
    <circle cx="516" cy="187" r="4" /><circle cx="548" cy="187" r="4" />
  </g>
  <text class="dg-lbl dg-num" x="400" y="266">GRAPHITE SHEETS</text>

  <path class="dg-a" d="M238 100 H382" marker-end="url(#li-ar-a)" />
  <path class="dg-page" d="M234 78 H298 V94 H234 Z" />
  <text class="dg-lbl dg-key" x="238" y="90">CHARGING</text>
  <path class="dg-m" d="M382 226 H238" marker-end="url(#li-ar)" />
  <path class="dg-page" d="M303 204 H386 V220 H303 Z" />
  <text class="dg-lbl dg-soft" x="382" y="216" text-anchor="end">DISCHARGING</text>

  <text class="dg-lbl" x="620" y="86">THE HOSTS ARE OTHERWISE UNCHANGED</text>
  <text class="dg-lbl dg-num" x="620" y="112">THE IONS SIT IN THE SPACE BETWEEN THE</text>
  <text class="dg-lbl dg-num" x="620" y="126">LAYERS AS GUESTS. THE LATTICES EXPAND</text>
  <text class="dg-lbl dg-num" x="620" y="140">AND CONTRACT BY UNDER TEN PERCENT AS</text>
  <text class="dg-lbl dg-num" x="620" y="154">THE GUESTS COME AND GO.</text>
  <text class="dg-lbl dg-soft" x="620" y="180">NO DISSOLUTION, NO REPLATING AND NO</text>
  <text class="dg-lbl dg-soft" x="620" y="194">STRUCTURAL REBUILD TO GO WRONG.</text>
  <text class="dg-lbl dg-key" x="620" y="220">THAT IS WHAT BUYS THE CYCLE LIFE.</text>
  <text class="dg-lbl dg-num" x="620" y="248">SONY, 1991 · HUNDREDS OF CYCLES</text>
  <path class="dg-m" d="M596 60 V266" />

  <!-- ══ how much the host swells ═══════════════════════════════════════ -->
  <path class="dg-m" d="M30 296 H930" />
  <path class="dg-m" d="M500 308 V478" />

  <text class="dg-lbl" x="30" y="322">HOW MUCH THE HOST SWELLS</text>

  <text class="dg-lbl dg-num" x="30" y="360">GRAPHITE</text>
  <rect x="230" y="348" width="8" height="14" class="dg-accent" />
  <text class="dg-lbl dg-key" x="248" y="360">UNDER 10%</text>

  <text class="dg-lbl dg-num" x="30" y="400">SILICON</text>
  <text class="dg-lbl dg-soft" x="230" y="382">ABOUT 300%</text>
  <rect x="230" y="388" width="240" height="14" class="dg-ink" />

  <text class="dg-lbl dg-soft" x="30" y="428">SILICON WOULD HOLD ROUGHLY TEN TIMES AS MUCH</text>
  <text class="dg-lbl dg-soft" x="30" y="442">LITHIUM, AND PULVERISES ITSELF WITHIN A FEW</text>
  <text class="dg-lbl dg-soft" x="30" y="456">CYCLES UNLESS THE STRUCTURE IS ENGINEERED</text>
  <text class="dg-lbl dg-soft" x="30" y="470">TO ACCOMMODATE IT.</text>

  <!-- ══ how it ages ════════════════════════════════════════════════════ -->
  <text class="dg-lbl" x="530" y="322">HOW IT AGES</text>

  <circle cx="590" cy="378" r="26" class="dg-tint" /><circle cx="590" cy="378" r="26" class="dg-m" />
  <circle cx="590" cy="378" r="24" class="dg-panel" /><circle cx="590" cy="378" r="24" class="dg-a" />
  <circle cx="700" cy="378" r="26" class="dg-tint" /><circle cx="700" cy="378" r="26" class="dg-m" />
  <circle cx="700" cy="378" r="21" class="dg-panel" /><circle cx="700" cy="378" r="21" class="dg-a" />
  <circle cx="810" cy="378" r="26" class="dg-tint" /><circle cx="810" cy="378" r="26" class="dg-m" />
  <circle cx="810" cy="378" r="17" class="dg-panel" /><circle cx="810" cy="378" r="17" class="dg-a" />
  <path class="dg-s" d="M796 362 L810 378 L802 396" />

  <g class="dg-soft">
    <text x="590" y="422" text-anchor="middle">EARLY</text>
    <text x="700" y="422" text-anchor="middle">LATER</text>
    <text x="810" y="422" text-anchor="middle">LATER STILL</text>
  </g>

  <text class="dg-lbl dg-soft" x="530" y="448">A SURFACE FILM GROWS ON THE ANODE AND CONSUMES A</text>
  <text class="dg-lbl dg-soft" x="530" y="462">LITTLE LITHIUM EACH CYCLE; REPEATED EXPANSION CRACKS</text>
  <text class="dg-lbl dg-soft" x="530" y="476">PARTICLES AND BREAKS THEIR ELECTRICAL CONTACT.</text>
</svg>
