---
/**
 * The condition is a product, so it can be met from either end: a thin plasma
 * held for seconds in a magnetic bottle, or a tiny mass crushed to enormous
 * density and held by its own inertia for nanoseconds. The bars at the bottom
 * are why the December 2022 result is a threshold and not a power station — the
 * gain is measured at the capsule, and the wall plug is off the same scale.
 */
---

<svg viewBox="0 0 960 516" role="img" aria-label="The triple product met two ways — magnetic confinement at low density for seconds and inertial confinement at extreme density for nanoseconds — and the energy accounting from wall plug to target to yield">
  <defs>
    <marker id="fu-ar-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-accent" />
    </marker>
  </defs>

  <!-- ══ the condition ══════════════════════════════════════════════════ -->
  <text class="dg-lbl" x="30" y="30">THE CONDITION IS A PRODUCT, NOT A SINGLE QUANTITY</text>

  <path class="dg-panel" d="M30 50 H140 V84 H30 Z" /><path class="dg-m" d="M30 50 H140 V84 H30 Z" />
  <path class="dg-panel" d="M168 50 H278 V84 H168 Z" /><path class="dg-m" d="M168 50 H278 V84 H168 Z" />
  <path class="dg-panel" d="M306 50 H446 V84 H306 Z" /><path class="dg-m" d="M306 50 H446 V84 H306 Z" />
  <text class="dg-lbl dg-num" x="85" y="71" text-anchor="middle">DENSITY</text>
  <text class="dg-lbl dg-num" x="223" y="71" text-anchor="middle">TEMPERATURE</text>
  <text class="dg-lbl dg-num" x="376" y="71" text-anchor="middle">CONFINEMENT TIME</text>
  <text class="dg-lbl dg-soft" x="154" y="71" text-anchor="middle">×</text>
  <text class="dg-lbl dg-soft" x="292" y="71" text-anchor="middle">×</text>
  <text class="dg-lbl dg-key" x="462" y="71">MUST EXCEED A THRESHOLD — AND THERE ARE TWO WAYS TO REACH IT</text>

  <!-- ══ the two routes ═════════════════════════════════════════════════ -->
  <path class="dg-m" d="M30 106 H930" />
  <path class="dg-m" d="M478 118 V306" />

  <text class="dg-lbl dg-num" x="30" y="140">MAGNETIC CONFINEMENT · THE TOKAMAK</text>

  <ellipse cx="230" cy="206" rx="110" ry="46" class="dg-panel" />
  <ellipse cx="230" cy="206" rx="110" ry="46" class="dg-s" />
  <ellipse cx="230" cy="206" rx="52" ry="20" class="dg-page" />
  <ellipse cx="230" cy="206" rx="52" ry="20" class="dg-s" />
  <ellipse cx="230" cy="206" rx="81" ry="33" class="dg-a-d" />
  <path class="dg-m" d="M120 196 v20 M340 196 v20 M230 160 h20 M230 252 h20" />
  <text class="dg-lbl dg-key" x="230" y="290" text-anchor="middle">A MAGNETIC BOTTLE</text>

  <text class="dg-lbl dg-soft" x="30" y="326">LOW DENSITY, HELD FOR SECONDS.</text>
  <text class="dg-lbl dg-num" x="30" y="344">JET SUSTAINED 59 MJ OVER FIVE SECONDS IN 2022.</text>
  <text class="dg-lbl dg-soft" x="30" y="358">ITER IS UNDER CONSTRUCTION IN FRANCE.</text>

  <text class="dg-lbl dg-num" x="500" y="140">INERTIAL CONFINEMENT · THE LASER SHOT</text>

  <g class="dg-a">
    <path d="M785 206 L741 206" marker-end="url(#fu-ar-a)" />
    <path d="M764 256 L733 225" marker-end="url(#fu-ar-a)" />
    <path d="M715 276 L715 232" marker-end="url(#fu-ar-a)" />
    <path d="M666 256 L697 225" marker-end="url(#fu-ar-a)" />
    <path d="M645 206 L689 206" marker-end="url(#fu-ar-a)" />
    <path d="M666 156 L697 187" marker-end="url(#fu-ar-a)" />
    <path d="M715 136 L715 180" marker-end="url(#fu-ar-a)" />
    <path d="M764 156 L733 187" marker-end="url(#fu-ar-a)" />
  </g>
  <circle cx="715" cy="206" r="16" class="dg-panel" /><circle cx="715" cy="206" r="16" class="dg-s" />
  <circle cx="715" cy="206" r="7" class="dg-accent" />
  <text class="dg-lbl dg-key" x="715" y="290" text-anchor="middle">A TINY MASS OF FUEL</text>

  <text class="dg-lbl dg-soft" x="500" y="326">EXTREME DENSITY, HELD BY ITS OWN INERTIA FOR</text>
  <text class="dg-lbl dg-soft" x="500" y="340">THE NANOSECONDS THE REACTION NEEDS.</text>
  <text class="dg-lbl dg-num" x="500" y="358">100 MILLION DEGREES.</text>

  <!-- ══ the accounting ═════════════════════════════════════════════════ -->
  <path class="dg-m" d="M30 378 H930" />
  <text class="dg-lbl" x="30" y="402">THE ENERGY ACCOUNTING, 5 DECEMBER 2022</text>

  <text class="dg-lbl dg-num" x="30" y="428">FROM THE WALL</text>
  <rect x="200" y="416" width="640" height="15" class="dg-ink" />
  <text class="dg-lbl dg-soft" x="850" y="428">~300 MJ</text>

  <text class="dg-lbl dg-num" x="30" y="454">INTO THE TARGET</text>
  <rect x="200" y="442" width="5" height="15" class="dg-accent" />
  <text class="dg-lbl dg-key" x="216" y="454">2.05 MJ</text>

  <text class="dg-lbl dg-num" x="30" y="480">OUT OF THE TARGET</text>
  <rect x="200" y="468" width="7" height="15" class="dg-accent" />
  <text class="dg-lbl dg-key" x="216" y="480">3.15 MJ</text>

  <text class="dg-lbl dg-soft" x="30" y="506">TARGET GAIN IS MEASURED AT THE CAPSULE. COUNTING THE ELECTRICITY THAT WENT INTO THE LASERS, THE SHOT RETURNED ABOUT ONE PERCENT.</text>
</svg>
