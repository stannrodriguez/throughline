---
/**
 * Two numbers that are easy to confuse: power is the height of the block, energy
 * is its area, and Hornsdale's shape is a hundred megawatts held for a bit over
 * an hour. The trace beside it is the property that actually earns the money —
 * an inverter closes a frequency excursion in milliseconds where a thermal plant
 * has to change the state of a large amount of hot metal first.
 */
---

<svg viewBox="0 0 960 484" role="img" aria-label="A hundred megawatts held for one and a third hours drawn as an area of 129 megawatt-hours, and a frequency excursion closed by an inverter in milliseconds against a thermal plant taking minutes">
  <defs>
    <marker id="gs-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-ink" />
    </marker>
  </defs>

  <!-- ══ power against energy ═══════════════════════════════════════════ -->
  <text class="dg-lbl" x="30" y="30">POWER IS THE HEIGHT · ENERGY IS THE AREA</text>

  <path class="dg-h" d="M110 117 H470 M110 183 H470" />
  <path class="dg-s" d="M110 80 V250 H470" />
  <g class="dg-num">
    <text x="102" y="121" text-anchor="end">100</text>
    <text x="102" y="187" text-anchor="end">50</text>
    <text x="102" y="254" text-anchor="end">0</text>
  </g>
  <text class="dg-lbl" x="110" y="70">MEGAWATTS</text>

  <path class="dg-m" d="M110 250 v5 M200 250 v5 M290 250 v5 M380 250 v5 M470 250 v5" />
  <g class="dg-num">
    <text x="110" y="272" text-anchor="middle">0</text>
    <text x="200" y="272" text-anchor="middle">1</text>
    <text x="290" y="272" text-anchor="middle">2</text>
    <text x="380" y="272" text-anchor="middle">3</text>
    <text x="470" y="272" text-anchor="middle">4</text>
  </g>
  <text class="dg-lbl" x="290" y="290" text-anchor="middle">HOURS OF DISCHARGE →</text>

  <path class="dg-tint" d="M110 117 H226 V250 H110 Z" />
  <path class="dg-a" d="M110 117 H226 V250" />
  <text class="dg-lbl dg-key" x="168" y="190" text-anchor="middle">129 MWh</text>
  <text class="dg-lbl dg-num" x="242" y="134">100 MW, FOR A BIT OVER AN HOUR</text>
  <text class="dg-lbl dg-soft" x="242" y="156">POWER IS THE RATE IT CAN DELIVER.</text>
  <text class="dg-lbl dg-soft" x="242" y="170">ENERGY IS THE TOTAL IT HOLDS.</text>

  <!-- ══ response time ══════════════════════════════════════════════════ -->
  <path class="dg-m" d="M508 20 V292" />
  <text class="dg-lbl" x="540" y="30">CLOSING A FREQUENCY EXCURSION</text>

  <path class="dg-d" d="M540 150 H920" />
  <text class="dg-lbl dg-soft" x="548" y="140">NOMINAL, 50 OR 60 Hz</text>
  <path class="dg-s" d="M540 80 V250 H920" />

  <path class="dg-m" d="M548 150 H600 L612 196 C664 194, 704 184, 784 166 C834 156, 884 151, 918 150" />
  <path class="dg-a" d="M548 150 H600 L612 196 C620 164, 630 152, 646 150 H918" />

  <path class="dg-m" d="M604 210 L640 208" marker-end="url(#gs-ar)" />
  <text class="dg-lbl dg-num" x="600" y="226">THE LOAD STEPS</text>
  <text class="dg-lbl dg-key" x="700" y="130">AN INVERTER · MILLISECONDS</text>
  <path class="dg-m" d="M712 136 L652 148" />
  <text class="dg-lbl dg-soft" x="700" y="204">A THERMAL PLANT · MINUTES</text>
  <text class="dg-lbl" x="730" y="272" text-anchor="middle">TIME →</text>
  <text class="dg-lbl dg-soft" x="540" y="290">IT MUST CHANGE THE STATE OF A LARGE AMOUNT OF HOT METAL.</text>

  <!-- ══ what they do, and do not, do ═══════════════════════════════════ -->
  <path class="dg-m" d="M30 310 H930" />
  <path class="dg-m" d="M572 322 V440" />

  <text class="dg-lbl" x="30" y="336">WHAT THEY MOSTLY DO</text>
  <text class="dg-lbl dg-num" x="30" y="360">MOST OF WHAT THESE INSTALLATIONS DO IS NOT STORAGE</text>
  <text class="dg-lbl dg-num" x="30" y="374">IN THE DAILY SENSE AT ALL.</text>
  <text class="dg-lbl dg-soft" x="30" y="398">IT IS FREQUENCY REGULATION — CORRECTING THE SMALL</text>
  <text class="dg-lbl dg-soft" x="30" y="412">CONTINUOUS MISMATCHES BETWEEN GENERATION AND LOAD,</text>
  <text class="dg-lbl dg-soft" x="30" y="426">WHICH IS WORTH MORE PER MEGAWATT-HOUR THAN ENERGY IS.</text>

  <text class="dg-lbl" x="600" y="336">WHAT THEY DO NOT DO</text>
  <text class="dg-lbl dg-num" x="600" y="360">STORING SUMMER SURPLUS FOR WINTER DEMAND</text>
  <text class="dg-lbl dg-num" x="600" y="374">NEEDS CAPACITIES HUNDREDS OF TIMES LARGER</text>
  <text class="dg-lbl dg-num" x="600" y="388">THAN ANYTHING INSTALLED, AT A COST PER</text>
  <text class="dg-lbl dg-num" x="600" y="402">KILOWATT-HOUR LITHIUM DOES NOT REACH.</text>
  <text class="dg-lbl dg-soft" x="600" y="424">WHICH IS WHY HYDROGEN, THERMAL STORES AND</text>
  <text class="dg-lbl dg-soft" x="600" y="438">PUMPED HYDRO ARE STILL BEING ARGUED ABOUT.</text>

  <path class="dg-m" d="M30 456 H930" />
  <text class="dg-lbl dg-num" x="30" y="478">HORNSDALE, SOUTH AUSTRALIA, 2015 · 100 MW / 129 MWh · MILLISECONDS TO RESPOND · ABOUT A 90% PRICE FALL</text>
</svg>
