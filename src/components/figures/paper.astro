---
/**
 * The vat and the mould. Beaten fibre suspended in water, a screen dipped and
 * lifted, the water draining through and leaving the mat behind, then couched
 * onto felt so the mould can go straight back in. The detail at right is why it
 * holds together with no thread and no glue: frayed cellulose surfaces hydrogen-
 * bonding to each other wherever they touch.
 */
---

<svg viewBox="0 0 960 400" role="img" aria-label="A paper vat and mould in four steps, the fibre mat in detail, and the sheet count from one vat against skins per parchment Bible">
  <defs>
    <marker id="pp-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-ink" />
    </marker>
    <marker id="pp-ar-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="dg-accent" />
    </marker>
  </defs>

  <text class="dg-lbl" x="30" y="24">THE VAT AND THE MOULD · ONE SHEET, FOUR MOVEMENTS</text>

  <!-- ── 1 · the vat ──────────────────────────────────────────────────── -->
  <text class="dg-lbl dg-num" x="30" y="56">1 · BEATEN PULP IN WATER</text>
  <path class="dg-s" d="M30 76 V180 H190 V76" />
  <path class="dg-tint" d="M34 104 H186 V176 H34 Z" />
  <g class="dg-m">
    <path d="M48 122 q10 -6 20 0 M84 134 q10 -6 20 0 M124 118 q10 -6 20 0 M152 142 q10 -6 20 0
             M56 154 q10 -6 20 0 M100 162 q10 -6 20 0 M138 152 q10 -6 20 0" />
  </g>
  <text class="dg-lbl dg-soft" x="30" y="200">RAG AND PLANT WASTE,</text>
  <text class="dg-lbl dg-soft" x="30" y="214">BEATEN UNTIL THE FIBRES FRAY</text>
  <path class="dg-m" d="M198 128 H222" marker-end="url(#pp-ar)" />

  <!-- ── 2 · dipped ───────────────────────────────────────────────────── -->
  <text class="dg-lbl dg-num" x="230" y="56">2 · THE MOULD DIPPED</text>
  <path class="dg-s" d="M230 76 V180 H390 V76" />
  <path class="dg-tint" d="M234 104 H386 V176 H234 Z" />
  <path class="dg-s" d="M252 112 L368 112 L360 148 L260 148 Z" />
  <g class="dg-h">
    <path d="M262 118 H358 M260 126 H360 M258 134 H362 M256 142 H364" />
  </g>
  <path class="dg-a" d="M310 84 V106" marker-end="url(#pp-ar-a)" />
  <text class="dg-lbl dg-soft" x="230" y="200">LIFTED FLAT AND SHAKEN,</text>
  <text class="dg-lbl dg-soft" x="230" y="214">SO THE FIBRES CROSS</text>
  <path class="dg-m" d="M398 128 H422" marker-end="url(#pp-ar)" />

  <!-- ── 3 · draining ─────────────────────────────────────────────────── -->
  <text class="dg-lbl dg-num" x="430" y="56">3 · WATER DRAINS THROUGH</text>
  <path class="dg-s" d="M446 96 H590 V112 H446 Z" />
  <g class="dg-h">
    <path d="M456 96 V112 M470 96 V112 M484 96 V112 M498 96 V112 M512 96 V112
             M526 96 V112 M540 96 V112 M554 96 V112 M568 96 V112 M582 96 V112" />
  </g>
  <rect x="446" y="88" width="144" height="8" class="dg-tint" />
  <g class="dg-a">
    <path d="M464 118 V150" marker-end="url(#pp-ar-a)" />
    <path d="M500 118 V162" marker-end="url(#pp-ar-a)" />
    <path d="M536 118 V150" marker-end="url(#pp-ar-a)" />
    <path d="M572 118 V162" marker-end="url(#pp-ar-a)" />
  </g>
  <text class="dg-lbl dg-key" x="430" y="200">THE MAT STAYS ON THE SCREEN</text>
  <text class="dg-lbl dg-soft" x="430" y="214">THE WATER DOES NOT</text>
  <path class="dg-m" d="M606 128 H630" marker-end="url(#pp-ar)" />

  <!-- ── 4 · couched ──────────────────────────────────────────────────── -->
  <text class="dg-lbl dg-num" x="638" y="56">4 · COUCHED ONTO FELT</text>
  <g>
    <rect x="646" y="150" width="150" height="9" class="dg-panel" /><rect x="646" y="150" width="150" height="9" class="dg-m" />
    <rect x="646" y="138" width="150" height="5" class="dg-page" /><rect x="646" y="138" width="150" height="5" class="dg-h" />
    <rect x="646" y="122" width="150" height="9" class="dg-panel" /><rect x="646" y="122" width="150" height="9" class="dg-m" />
    <rect x="646" y="110" width="150" height="5" class="dg-page" /><rect x="646" y="110" width="150" height="5" class="dg-h" />
    <rect x="646" y="94" width="150" height="9" class="dg-panel" /><rect x="646" y="94" width="150" height="9" class="dg-m" />
  </g>
  <path class="dg-a" d="M700 74 V90" marker-end="url(#pp-ar-a)" />
  <text class="dg-lbl dg-soft" x="806" y="100">SHEET</text>
  <text class="dg-lbl dg-soft" x="806" y="128">FELT</text>
  <text class="dg-lbl dg-soft" x="638" y="200">THE MOULD GOES STRAIGHT BACK IN,</text>
  <text class="dg-lbl dg-soft" x="638" y="214">SO ONE VAT KEEPS PRODUCING</text>

  <!-- ══ the mat, in detail ═════════════════════════════════════════════ -->
  <path class="dg-m" d="M30 240 H930" />
  <text class="dg-lbl" x="30" y="262">WHY IT HOLDS TOGETHER · NO THREAD, NO GLUE, NO ANIMAL</text>

  <rect x="30" y="274" width="360" height="106" class="dg-h" />
  <g class="dg-m">
    <path d="M40 296 C96 282, 132 320, 198 304 C250 292, 306 320, 380 300" />
    <path d="M38 344 C88 336, 122 356, 176 340 C238 322, 298 350, 382 336" />
    <path d="M52 372 C112 356, 168 374, 226 356 C280 340, 330 366, 376 358" />
    <path d="M64 278 C88 306, 58 330, 78 376" />
    <path d="M142 280 C120 310, 168 332, 130 376" />
    <path d="M212 278 C240 304, 196 336, 226 374" />
    <path d="M300 282 C272 308, 318 334, 288 376" />
    <path d="M354 278 C338 312, 372 336, 348 374" />
    <path d="M44 316 C104 336, 168 300, 232 322 C288 340, 336 316, 380 324" />
  </g>
  <g class="dg-accent">
    <circle cx="103" cy="311" r="3" /><circle cx="152" cy="330" r="3" /><circle cx="215" cy="296" r="3" />
    <circle cx="241" cy="330" r="3" /><circle cx="318" cy="298" r="3" /><circle cx="322" cy="352" r="3" />
    <circle cx="76" cy="357" r="3" /><circle cx="192" cy="356" r="3" />
  </g>
  <text class="dg-lbl dg-key" x="404" y="298">HYDROGEN BONDS WHEREVER TWO</text>
  <text class="dg-lbl dg-key" x="404" y="312">FRAYED SURFACES TOUCH</text>
  <text class="dg-lbl dg-soft" x="404" y="336">A RANDOM TANGLE, NOT A WEAVE — WHICH IS WHY</text>
  <text class="dg-lbl dg-soft" x="404" y="350">NOTHING HAS TO BE SPUN OR ORDERED FIRST.</text>
  <text class="dg-lbl dg-num" x="404" y="374">PAPER IS LESS DURABLE THAN PARCHMENT AND WINS ON VOLUME:</text>
  <text class="dg-lbl dg-soft" x="404" y="388">A PARCHMENT BIBLE COSTS ABOUT 200 SKINS. THE VAT COSTS RAGS.</text>
</svg>
