---
/**
 * Figures are placeholders by design. The caption is the commissioning spec for
 * the real technical illustration (Macaulay-spirit cutaway, patent linework).
 */
interface Props {
  caption: string;
  spec?: string;
}
const { caption, spec } = Astro.props;
---

<figure class="figure-ph">
  <figcaption class="figure-ph__caption">
    {caption}
    {spec && <><br /><span class="figure-ph__spec">{spec}</span></>}
  </figcaption>
</figure>

<style>
  .figure-ph {
    margin: 0;
  }
</style>
