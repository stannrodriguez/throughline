---
import '../styles/global.css';
import { SITE } from '../lib/site';
import type { ThreadId } from '../data/threads';

interface Props {
  title: string;
  description?: string;
  /** Sets the --thread channel for the whole page (link hover, accents). */
  thread?: ThreadId;
}

const { title, description = SITE.description, thread } = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Libre+Franklin:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={thread ? `t-${thread}` : undefined}>
    <slot />
  </body>
</html>
